# Promethean PRM-35 projector on the ethernet port, see /data/local/projector-net.sh
service projector_net /system/bin/sh /data/local/projector-net.sh
    class main
    user root
    group root
    disabled
    oneshot
    seclabel u:r:init:s0

on property:sys.boot_completed=1
    start projector_net
